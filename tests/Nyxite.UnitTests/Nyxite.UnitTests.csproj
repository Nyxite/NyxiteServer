<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Nyxite.UnitTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Otp.NET" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Nyxite.Server/Nyxite.Server.csproj" />
    <ProjectReference Include="../../src/Nyxite.Crdt/Nyxite.Crdt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources/vectors/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
